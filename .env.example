# Public URL used for secure Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for the separate administrator sign-in. Use different long random values.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional durable production database. Leave blank to use the local demo store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional word-level Whisper transcription. Leave blank for demo transcript mode.
OPENAI_API_KEY=

# Optional real checkout. Leave blank for local demo checkout mode.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
