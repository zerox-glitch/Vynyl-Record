    <!-- Onboarding -->
    <string name="onboarding_1_title">A voice they can return to.</string>
    <string name="onboarding_1_body">Record a few seconds of the people you love. It is pressed into wax on this phone, and it stays on this phone.</string>
    <string name="onboarding_2_title">Pressed locally.</string>
    <string name="onboarding_2_body">The recording, the warmth, the crackle and the mastering all happen on the device. No account, no upload, no waiting for a server.</string>
    <string name="onboarding_3_title">Yours to keep.</string>
    <string name="onboarding_3_body">Export a record as audio, artwork or a portable Vynyl bundle, and back up the whole shelf whenever you like. Uninstalling without a backup removes records that were never exported.</string>
