# Public URL used for secure Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for the separate administrator sign-in. Use different long random values.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional durable production database. Leave blank to use the local demo store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required to sign direct upload capabilities. Use a long random secret.
R2_UPLOAD_SECRET=
# Optional Cloudflare R2 object storage. Leave blank for local/temp fallback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE=
# Optional worker drain secret. Also used by Vercel Cron if CRON_SECRET is absent.
PROCESSING_WORKER_SECRET=
CRON_SECRET=

# Optional word-level Whisper transcription. Leave blank for disabled transcript job.
OPENAI_API_KEY=

# Optional real checkout. Leave blank for local demo checkout mode.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
