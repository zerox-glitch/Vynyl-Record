<?xml version="1.0" encoding="utf-8"?>
<!--
  What the FileProvider is allowed to hand out. Exports are written into files/exports and shared from
  there; nothing else in the app's private storage is reachable through this provider.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path
        name="exports"
        path="exports/" />
    <cache-path
        name="shared_cache"
        path="shared/" />
</paths>
